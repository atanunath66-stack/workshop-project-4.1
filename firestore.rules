
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------
    // DEFAULT DENY
    // --------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // --------------------------------------------------
    // AUTHENTICATION & ADMIN HELPERS
    // --------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (
          request.auth.token.email_verified == true &&
          request.auth.token.email in [
            'atanunath66@gmail.com',
            'atanunath44@gmail.com',
            'atanuhuhu@gmail.com'
          ]
        ) ||
        (
          request.auth.token.keys().hasAll(['admin']) &&
          request.auth.token.admin == true
        ) ||
        (
          request.auth.token.keys().hasAll(['role']) &&
          request.auth.token.role == 'admin'
        )
      );
    }

    function isOwner(userId) {
      return isSignedIn() &&
        request.auth.uid == userId;
    }

    function isRestaurantOwner(restaurantId) {
      return isSignedIn() &&
        exists(
          /databases/$(database)/documents/restaurants/$(restaurantId)
        ) &&
        get(
          /databases/$(database)/documents/restaurants/$(restaurantId)
        ).data.ownerId == request.auth.uid;
    }

    function isRestaurantOwnerForBooking() {
      return isSignedIn() && (
        (
          'restaurantOwnerId' in resource.data &&
          resource.data.restaurantOwnerId == request.auth.uid
        ) ||
        (
          'restaurantId' in resource.data &&
          isRestaurantOwner(resource.data.restaurantId)
        )
      );
    }

    // --------------------------------------------------
    // BOOKING STATUS TRANSITIONS
    // --------------------------------------------------

    function isValidOwnerBookingStatusTransition(currentStatus, nextStatus) {
      return
        nextStatus == currentStatus ||

        (currentStatus == 'PENDING' &&
          nextStatus in ['ACCEPTED', 'REJECTED']) ||

        (currentStatus == 'CONFIRMED' &&
          nextStatus in ['ACCEPTED', 'REJECTED']) ||

        (currentStatus == 'ACCEPTED' &&
          nextStatus in ['CUSTOMER ARRIVING', 'ARRIVED', 'REJECTED']) ||

        (currentStatus == 'CUSTOMER ARRIVING' &&
          nextStatus in ['ARRIVED', 'REJECTED']) ||

        (currentStatus == 'ARRIVED' &&
          nextStatus in ['SERVED', 'COMPLETED']) ||

        (currentStatus == 'SERVED' &&
          nextStatus == 'COMPLETED');
    }

    // --------------------------------------------------
    // RESTAURANT CREATION
    // --------------------------------------------------

    function isAllowedRestaurantCreate() {
      return isSignedIn() &&

        request.resource.data.ownerId == request.auth.uid &&

        request.resource.data.status == 'PENDING_APPROVAL' &&

        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&

        request.resource.data.keys().hasOnly([
          'id',
          'name',
          'tagline',
          'description',
          'ownerId',
          'ownerName',
          'phone',
          'ownerPhone',
          'email',
          'address',
          'area',
          'city',
          'lat',
          'lng',
          'location',
          'coverImage',
          'galleryImages',
          'categories',
          'openingTime',
          'closingTime',
          'priceForTwo',
          'status',
          'facilities',
          'cancellationPolicy',
          'menu',
          'totalTables',
          'availableTables',
          'discountOffer',
          'createdAt',
          'updatedAt'
        ]);
    }

    // --------------------------------------------------
    // RESTAURANT OWNER UPDATES
    // --------------------------------------------------

    function isAllowedRestaurantOwnerUpdate() {
      return isSignedIn() &&

        resource.data.ownerId == request.auth.uid &&

        request.resource.data.ownerId == resource.data.ownerId &&

        request.resource.data.status == resource.data.status &&

        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'tagline',
            'description',
            'phone',
            'ownerPhone',
            'email',
            'address',
            'area',
            'city',
            'lat',
            'lng',
            'location',
            'coverImage',
            'galleryImages',
            'categories',
            'openingTime',
            'closingTime',
            'priceForTwo',
            'facilities',
            'cancellationPolicy',
            'menu',
            'totalTables',
            'availableTables',
            'updatedAt'
          ]);
    }

    // --------------------------------------------------
    // BOOKING CREATION
    // --------------------------------------------------

    function isAllowedBookingCreate() {
      return isSignedIn() &&

        request.resource.data.customerId == request.auth.uid &&

        request.resource.data.status == 'PENDING' &&

        request.resource.data.paymentStatus == 'PENDING' &&

        request.resource.data.keys().hasOnly([
          'id',
          'receiptNumber',
          'customerId',
          'customerName',
          'customerPhone',
          'customerEmail',
          'restaurantId',
          'restaurantName',
          'restaurantAddress',
          'restaurantOwnerId',
          'bookingType',
          'numberOfGuests',
          'seatingPreference',
          'arrivalDate',
          'arrivalTime',
          'items',
          'discountCode',
          'advancePercentage',
          'status',
          'paymentStatus',
          'cancellationPolicySnapshot',
          'createdAt',
          'updatedAt'
        ]);
    }

    // --------------------------------------------------
    // CUSTOMER BOOKING UPDATES
    // --------------------------------------------------

    function isAllowedCustomerBookingUpdate() {
      return isSignedIn() &&

        resource.data.customerId == request.auth.uid &&

        request.resource.data.customerId == resource.data.customerId &&

        request.resource.data.restaurantId == resource.data.restaurantId &&

        (
          !('restaurantOwnerId' in resource.data) ||
          request.resource.data.restaurantOwnerId ==
            resource.data.restaurantOwnerId
        ) &&

        (
          request.resource.data.status == resource.data.status ||

          (
            resource.data.status in [
              'PENDING',
              'CONFIRMED',
              'ACCEPTED'
            ] &&
            request.resource.data.status == 'CANCELLED'
          )
        ) &&

        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'cancellationReason',
            'customerLocationShared',
            'customerCurrentLocation',
            'updatedAt'
          ]);
    }

    // --------------------------------------------------
    // RESTAURANT OWNER BOOKING UPDATES
    // --------------------------------------------------

    function isAllowedRestaurantOwnerBookingUpdate() {
      return isSignedIn() &&

        isRestaurantOwnerForBooking() &&

        request.resource.data.customerId == resource.data.customerId &&

        request.resource.data.restaurantId == resource.data.restaurantId &&

        (
          !('restaurantOwnerId' in resource.data) ||
          request.resource.data.restaurantOwnerId ==
            resource.data.restaurantOwnerId
        ) &&

        isValidOwnerBookingStatusTransition(
          resource.data.status,
          request.resource.data.status
        ) &&

        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'rejectionReason',
            'suggestedAlternativeTime',
            'updatedAt'
          ]);
    }

    // --------------------------------------------------
    // USERS
    // --------------------------------------------------

    match /users/{userId} {

      allow get: if
        isOwner(userId) || isSuperAdmin();

      allow list: if isSuperAdmin();

      // Users can create customer profiles.
      // Owner promotion must be performed by an admin.
      allow create: if isSuperAdmin() || (
        isOwner(userId) &&
        request.resource.data.id == userId &&
        (
          !('role' in request.resource.data) ||
          request.resource.data.role == 'customer'
        )
      );

      // Users cannot promote themselves to owner or admin.
      allow update: if isSuperAdmin() || (
        isOwner(userId) &&
        request.resource.data.id == resource.data.id &&
        (
          !('role' in request.resource.data) ||
          request.resource.data.role == resource.data.role
        )
      );

      allow delete: if isSuperAdmin();
    }

    // --------------------------------------------------
    // RESTAURANTS
    // --------------------------------------------------

    match /restaurants/{restaurantId} {

      allow get, list: if
        resource.data.status == 'ACTIVE' ||
        (
          isSignedIn() &&
          resource.data.ownerId == request.auth.uid
        ) ||
        isSuperAdmin();

      allow create: if
        isSuperAdmin() ||
        isAllowedRestaurantCreate();

      allow update: if
        isSuperAdmin() ||
        isAllowedRestaurantOwnerUpdate();

      allow delete: if isSuperAdmin();
    }

    // --------------------------------------------------
    // BOOKINGS
    // --------------------------------------------------

    match /bookings/{bookingId} {

      allow get, list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        isRestaurantOwnerForBooking() ||
        isSuperAdmin()
      );

      allow create: if
        isSuperAdmin() ||
        isAllowedBookingCreate();

      allow update: if
        isSuperAdmin() ||
        isAllowedCustomerBookingUpdate() ||
        isAllowedRestaurantOwnerBookingUpdate();

      allow delete: if isSuperAdmin();
    }

    // --------------------------------------------------
    // DISCOUNTS
    // --------------------------------------------------

    match /discounts/{discountId} {

      allow read: if
        resource.data.isActive == true ||
        isSuperAdmin();

      allow write: if isSuperAdmin();
    }

    // --------------------------------------------------
    // AUDIT LOGS
    // --------------------------------------------------

    match /auditLogs/{logId} {

      allow read: if isSuperAdmin();

      allow create: if isSuperAdmin();

      allow update, delete: if false;
    }

    // --------------------------------------------------
    // ADMIN DIRECTORY
    // --------------------------------------------------

    match /admins/{adminId} {

      allow read, write: if isSuperAdmin();
    }

    // --------------------------------------------------
    // TEST / DIAGNOSTICS
    // --------------------------------------------------

    match /test/{docId} {

      allow read: if isSignedIn();

      allow write: if isSuperAdmin();
    }
  }
}
